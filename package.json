{
  "name": "teamcodex",
  "version": "1.3.0",
  "description": "One local proxy for both Claude Code and Codex. Quota-aware account rotation, zero dependencies.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "teamclaude": "src/teamclaude.js",
    "teamcodex": "src/index.js"
  },
  "files": [
    "src/",
    "README.ko.md",
    "README.zh-CN.md",
    "config.example.json",
    "config.codex.example.json"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "menubar:test": "bash menubar/run-tests.sh",
    "menubar:build": "bash menubar/build.sh",
    "menubar:install": "bash menubar/install.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "chatgpt",
    "proxy",
    "load-balancer",
    "multi-account",
    "rate-limit",
    "quota",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sangrokjung/teamclaude.git"
  },
  "homepage": "https://github.com/sangrokjung/teamclaude#readme",
  "bugs": {
    "url": "https://github.com/sangrokjung/teamclaude/issues"
  },
  "author": "Sangrok Jung",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}

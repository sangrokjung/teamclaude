{
  "provider": "grok",
  "proxy": {
    "port": 3458,
    "apiKey": "tc-change-me-to-a-secret"
  },
  "upstream": "https://cli-chat-proxy.grok.com/v1",
  "accounts": [
    {
      "name": "grok-primary",
      "provider": "grok",
      "type": "oauth",
      "accountUuid": "<grok-user-id>",
      "accessToken": "<grok-access-token>",
      "refreshToken": "<grok-refresh-token>",
      "expiresAt": 0,
      "oauthIssuer": "https://auth.x.ai",
      "oauthClientId": "<grok-oidc-client-id>"
    }
  ]
}
